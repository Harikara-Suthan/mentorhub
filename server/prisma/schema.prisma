generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  HOD
  MENTOR
  STUDENT
  ADMIN
}

enum MeetingType {
  INDIVIDUAL
  GROUP
}

enum IssueCategory {
  ACADEMIC_PERFORMANCE
  ATTENDANCE
  ARREAR_SUBJECTS
  PLACEMENT_READINESS
  INTERNSHIP_STATUS
  FINANCIAL_CONCERNS
  PERSONAL_WELLBEING
  DISCIPLINE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ActionType {
  STUDENT_ACTION
  MENTOR_ACTION
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PlacementStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  IN_PROGRESS
  PLACED
}

enum FeeStatus {
  PAID
  PARTIALLY_PAID
  PENDING
  OVERDUE
}

enum InternshipStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  UPCOMING_MEETING
  FOLLOW_UP
  OVERDUE_ACTION
  REPEATED_ISSUE
  MONTHLY_REMINDER
  RISK_CHANGE
  GENERAL
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model Department {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now())

  mentors  Mentor[]
  students Student[]
  whatsappGroups WhatsAppGroup[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  profilePicture String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mentor       Mentor?
  student      Student?
  notifications Notification[]
  auditLogs    AuditLog[]

  @@index([role])
}

model Mentor {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  employeeId   String   @unique
  designation  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  phone        String?
  profilePicture String?
  qualification String?
  specialization String?
  experience   String?
  dateOfJoining DateTime?
  employmentStatus String?
  cabinNumber  String?
  researchInterests String[] @default([])
  education    String?
  awards       String[] @default([])
  address      String?
  city         String?
  state        String?
  bio          String?
  createdAt    DateTime @default(now())

  students     Student[]
  meetings     Meeting[]
  issues       StudentIssue[]  @relation("AssignedMentorIssues")
  actionsAssigned ActionItem[] @relation("MentorAssignedActions")
  interventions   Intervention[]

  @@index([departmentId])
}

model Student {
  id                   String   @id @default(cuid())
  userId               String?  @unique
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName             String
  registerNumber       String   @unique
  rollNumber           String?  @unique
  admissionNumber      String?
  admissionYear        Int?
  academicYear         String?
  dateOfAdmission      DateTime?
  admissionCategory    String?
  degree               String?
  batch                String?
  year                 String
  section              String
  semester             Int?
  departmentId         String
  department           Department @relation(fields: [departmentId], references: [id])
  mentorId             String
  mentor               Mentor   @relation(fields: [mentorId], references: [id])

  parentName           String?
  parentContact        String?
  email                String?
  phone                String?
  dateOfBirth          DateTime?
  gender               String?
  address              String?
  city                 String?
  state                String?
  zipCode              String?
  emergencyContactName String?
  emergencyContactRelation String?
  emergencyContactPhone String?
  emergencyContact     String?
  careerGoal           String?
  targetRole           String?
  skills               String[] @default([])
  certifications       String[] @default([])
  interests            String[] @default([])
  githubUrl            String?
  linkedinUrl          String?
  portfolioUrl         String?
  resumeUrl            String?
  bio                  String?
  profilePicture       String?

  bankName             String?
  accountHolderName    String?
  accountNumber        String?
  ifscCode             String?

  attendancePercentage Float    @default(100)
  cgpa                 Float    @default(0)
  arrearCount          Int      @default(0)
  placementStatus      PlacementStatus  @default(NOT_ELIGIBLE)
  internshipStatus     InternshipStatus @default(NOT_STARTED)
  certificationCount   Int      @default(0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  meetings             Meeting[]
  issues               StudentIssue[]
  actionItems          ActionItem[]
  riskAssessments      RiskAssessment[]
  interventions        Intervention[]
  fees                 StudentFee[]

  @@index([mentorId])
  @@index([departmentId])
  @@index([registerNumber])
  @@index([rollNumber])
}

model Meeting {
  id                  String      @id @default(cuid())
  studentId           String
  student             Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorId            String
  mentor              Mentor      @relation(fields: [mentorId], references: [id])

  meetingDate         DateTime
  meetingType         MeetingType @default(INDIVIDUAL)
  discussionSummary   String
  studentConcerns     String?
  mentorSuggestions   String?
  nextFollowUpDate    DateTime?

  aiSummary           String?
  aiKeyConcerns        String[]  @default([])
  aiImportantPoints    String[]  @default([])
  aiRecommendedActions String[]  @default([])
  aiStatus             String   @default("PENDING") // PENDING | COMPLETED | FAILED

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  issues              StudentIssue[]
  actionItems         ActionItem[]
  riskAssessment      RiskAssessment?

  @@index([studentId])
  @@index([mentorId])
  @@index([meetingDate])
}

model StudentIssue {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  meetingId       String?
  meeting         Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  mentorId        String
  mentor          Mentor        @relation("AssignedMentorIssues", fields: [mentorId], references: [id])

  category        IssueCategory
  description     String
  severity        Severity      @default(MEDIUM)
  status          IssueStatus   @default(OPEN)
  isRestricted    Boolean       @default(false)

  resolution      String?
  resolvedDate    DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  actionItems     ActionItem[]

  @@index([studentId])
  @@index([category])
  @@index([status])
}

model ActionItem {
  id                    String       @id @default(cuid())
  studentId             String
  student               Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  meetingId             String?
  meeting               Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  issueId               String?
  issue                 StudentIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  mentorId              String
  mentor                Mentor       @relation("MentorAssignedActions", fields: [mentorId], references: [id])

  actionType            ActionType   @default(STUDENT_ACTION)
  description           String
  assignedTo            String       // free text label: student name / mentor name
  targetCompletionDate  DateTime
  status                ActionStatus @default(PENDING)
  completedDate         DateTime?

  createdAt             DateTime     @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([targetCompletionDate])
}

model RiskAssessment {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  meetingId     String?   @unique
  meeting       Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  riskScore     Int
  riskLevel     RiskLevel
  breakdown     Json      // explainable scoring components
  generatedBy   String    @default("AI") // AI | MANUAL

  createdAt     DateTime  @default(now())

  @@index([studentId])
  @@index([riskLevel])
}

model Intervention {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorId     String
  mentor       Mentor   @relation(fields: [mentorId], references: [id])

  issueArea    String
  recommendation String
  status       String   @default("SUGGESTED") // SUGGESTED | ACCEPTED | DISMISSED | DONE

  createdAt    DateTime @default(now())

  @@index([studentId])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean           @default(false)
  entityId  String?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([isRead])
}

model Report {
  id          String   @id @default(cuid())
  type        String   // MONTHLY | SEMESTER | STUDENT | MENTOR | ISSUES | ACTIONS
  title       String
  filters     Json?
  generatedBy String
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity])
}

model Message {
  id            String   @id @default(cuid())
  senderId      String
  senderName    String
  senderRole    String
  recipientId   String
  recipientName String
  recipientRole String
  content       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model WhatsAppGroup {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  batch        String
  section      String
  createdAt    DateTime @default(now())

  messages     WhatsAppMessage[]

  @@unique([departmentId, batch, section])
}

model WhatsAppMessage {
  id              String   @id @default(cuid())
  groupId         String
  group           WhatsAppGroup @relation(fields: [groupId], references: [id])
  senderId        String
  content         String
  createdAt       DateTime @default(now())
}

model StudentFee {
  id               String     @id @default(cuid())
  studentId        String
  student          Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear     String?
  semester         Int?
  feeCategory      String?    // e.g., "Tuition Fee", "Hostel & Mess", "Transport", "Composite Fee"
  totalFees        Float      @default(0)
  amountPaid       Float      @default(0)
  status           FeeStatus  @default(PENDING)
  dueDate          DateTime?
  lastPaymentDate  DateTime?
  paymentReference String?    // Transaction ID / Receipt No
  remarks          String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([studentId])
  @@index([status])
}

model WhatsAppNotification {
  id                String    @id @default(cuid())
  eventType         String    // ATTENDANCE_RISK | FEE_DUE | FEE_OVERDUE | FACULTY_MEETING_REMINDER | ARREAR_WARNING | ACTION_ITEM_OVERDUE | PLACEMENT_REMINDER | MANUAL_ALERT
  sourceRecordId    String?
  sourceTable       String?
  recipientType     String    // STUDENT | PARENT | FACULTY | HOD | ADMIN
  recipientName     String
  recipientPhone    String
  studentId         String?
  departmentId      String?
  mentorId          String?
  templateName      String
  templateVariables Json?
  messageBody       String
  status            String    @default("PENDING") // PENDING | PROCESSING | SENT | DELIVERED | READ | FAILED | CANCELLED | RECIPIENT_UNAVAILABLE
  providerMessageId String?
  failureReason     String?
  attemptCount      Int       @default(0)
  maxAttempts       Int       @default(3)
  nextRetryAt       DateTime?
  dedupKey          String?
  scheduledAt       DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([dedupKey])
  @@index([studentId])
  @@index([departmentId])
  @@index([createdAt])
}

model WhatsAppOptIn {
  id            String    @id @default(cuid())
  phone         String    @unique
  recipientType String
  recipientName String?
  optedIn       Boolean   @default(true)
  optedInAt     DateTime  @default(now())
  optedOutAt    DateTime?
  consentSource String    @default("INSTITUTIONAL_ADMISSION_RECORDS")
  createdAt     DateTime  @default(now())
}

model WhatsAppRuleConfig {
  id                         String   @id @default("GLOBAL")
  departmentId               String?
  attendanceRiskThreshold    Float    @default(75.0)
  feeDueAlertDaysBefore      Int      @default(7)
  meetingReminderHoursBefore Int      @default(24)
  enableAttendanceAlerts     Boolean  @default(true)
  enableFeeAlerts            Boolean  @default(true)
  enableMeetingReminders     Boolean  @default(true)
  enableArrearAlerts         Boolean  @default(true)
  enableOverdueActionAlerts  Boolean  @default(true)
  dedupCooldownHours         Int      @default(168)
  quietHoursStart            String?  @default("21:00")
  quietHoursEnd              String?  @default("08:00")
  updatedAt                  DateTime @updatedAt
}


